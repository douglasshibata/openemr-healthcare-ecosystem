# ==============================================================================
# OpenEMR Integrated Healthcare Ecosystem - Production Ready Environment Configuration
# ==============================================================================

# --- OpenEMR Core Configurations ---
OPENEMR_PORT=8300
OPENEMR_MYSQL_ROOT_PASSWORD=OpenEMRSecurePass2026!
OPENEMR_MYSQL_USER=openemr_user
OPENEMR_MYSQL_PASSWORD=OpenEMRDbPass2026!
OPENEMR_MYSQL_DATABASE=openemr_db

# --- SMTP / E-mail Configurations (for Patient Portal/OpenEMR Notifications) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=smtp_username_here
SMTP_PASS=smtp_password_here
SMTP_FROM=no-reply@healthtech-ecosystem.com

# --- Auxiliary Infrastructure Configurations ---
# PostgreSQL (HIPAA/LGPD Audit Logs & Cache)
POSTGRES_DB=healthtech_aux
POSTGRES_USER=health_admin
POSTGRES_PASSWORD=AuxDbSecurePass2026!
POSTGRES_PORT=5432

# Redis (BullMQ queues and session cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisSecurePass2026!

# --- Custom Middleware Gateway Server ---
MIDDLEWARE_PORT=3000
NODE_ENV=development
JWT_SECRET=JWTAccessTokenSecretSecure2026!

# --- SMART on FHIR Credentials (from OpenEMR API Client Registrations) ---
OPENEMR_FHIR_BASE_URL=http://openemr:80/apis/default/fhir
OPENEMR_CLIENT_ID=openemr_oauth_client_id_here
OPENEMR_CLIENT_SECRET=openemr_oauth_client_secret_here
OPENEMR_TOKEN_URL=http://openemr:80/oauth2/default/token

# --- Encryption and HIPAA/LGPD Security Keys ---
# 32-byte hexadecimal key for AES-256-GCM symmetric encryption
DB_ENCRYPTION_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e
AUDIT_LOG_SALT=SecureSaltForAuditSignatures2026!
